{
  "redirects": [
    {
      "destination": "/lookmood",
      "permanent": false,
      "source": "/"
    },
    {
      "destination": "/lookmood",
      "permanent": false,
      "source": "/index.html"
    },
    {
      "destination": "/lookmood",
      "permanent": false,
      "source": "/eat/:path*"
    },
    {
      "destination": "/lookmood",
      "permanent": false,
      "source": "/wear/:path*"
    },
    {
      "destination": "/lookmood",
      "permanent": false,
      "source": "/watch/:path*"
    },
    {
      "destination": "/lookmood",
      "permanent": false,
      "source": "/food-finder-map.html"
    }
  ],
  "rewrites": [
    {
      "destination": "/api/kakao",
      "source": "/api/kakao/search"
    },
    {
      "destination": "/lookmood/index.html",
      "source": "/lookmood"
    },
    {
      "destination": "/lookmood/looks/001/index.html",
      "source": "/lookmood/looks/001"
    },
    {
      "source": "/lookmood/looks/002",
      "destination": "/lookmood/looks/002/index.html"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/lookmood/:path*"
    }
  ],
  "trailingSlash": false
}
